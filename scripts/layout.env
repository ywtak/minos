# eMMC layout of this Kindle 5th gen (fw 4.1.4), read from its full backup.
# Every number is verified; see NOTES.md. Sourced by flash.sh.
MAIN_KERNEL_OFFSET=266240        # Amazon's kernel; checked, never written
ROOTFS_PART=/dev/mmcblk0p1       # Amazon system -> minios system
ROOTFS_MAX=367001600
DIAGS_PART=/dev/mmcblk0p2        # diags system, wiped by install
DIAGS_PART_LEN=67108864
DIAGS_KERNEL_OFFSET=14946304     # diags kernel, wiped by install
DIAGS_KERNEL_LEN=5122560
